{# needs a function as root context -#}

{%- for variable in ctx.variables %}
{{ ctx.sourceLocationCurlyOpen | render }}{{ variable.typeSymbol | c_type }} {{ variable.name }} = {{ variable | null_value }};
{%- endfor %}

{%- if ctx.gcVariableCount() > 0 %}
/* GC managed variables */
{{ ctx.sourceLocationCurlyOpen | render }}caffc_ptr _caffc_locals[{{ ctx.objParametersAndVariables.size() }}];

{%- for item in ctx.objParametersAndVariables %}
{{ ctx.sourceLocationCurlyOpen | render }}_caffc_locals[{{ loop.index }}] = &{{ item | render }};
{%- endfor %}

{{ ctx.sourceLocationCurlyOpen | render }}_caffc_stack_frame_register({{ ctx.stringConstantName | render }}, _caffc_locals, {{ ctx.gcVariableCount() }});

{%- else %}
{{ ctx.sourceLocationCurlyOpen | render }}_caffc_stack_frame_register({{ ctx.stringConstantName | render }}, caffc_null, 0);
{% endif %}
