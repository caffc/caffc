/* caffc module: {{ ctx.name }} */
#ifdef __cplusplus
extern "C" {
#endif

#include "{{ ctx | c_global_header }}"

/* **************************************************************
global variables
************************************************************** */
{%- for globalVar in ctx.globalVariables.values() %}
{{ globalVar.typeSymbol | c_type }} {{ globalVar.name }};
{%- endfor %}

{# we create a generic caffc array, and we patch its header for NEW constructs #}
/* **************************************************************
array constructors
************************************************************** */
{%- for array in ctx.registeredArrays %}
{%- if array.arrayDimensions == 1 %}

{# primitives arrays are actually just a `#define` on the actual array type constructor #}
{%- if array.childType.dataType != "PRIMITIVE" -%}
{{ array | c_name }}* {{ array | c_name }}_newa(caffc_i32 size) {
    caffc_obj_arr* _this = caffc_obj_arr_new(size);
    /* _this->_caffc_contained_type_id = {{ array.childType }}; {{ array.childType }} */

    return ({{ array | c_name }}*) _this;
}
{%- endif %}

{# we create the multi instantiation as well -#}
{%- elseif array.arrayDimensions > 1 %}
{{ array | c_type }} {{ array | c_name }}_newa({% for i in range(1, array.arrayDimensions) %}caffc_i32 s{{ i }}{% if not loop.last %}, {% endif %}{% endfor %}) {
    caffc_i32 i;
    {{ array | c_type }} _this = caffc_null;
    caffc_ptr arr_child = caffc_null;

    /* wiring up GC */
    caffc_ptr _caffc_locals[] = { caffc_null, caffc_null };
    _caffc_locals[0] = &_this;
    _caffc_locals[1] = &arr_child;

    _caffc_stack_frame_register("<new[][]>", _caffc_locals, 2);

    /* actual new for the top array */
    _this = ({{ array | c_type }}) caffc_obj_arr_new(s1);
    if (_caffc_exception) { goto newArrayException; }

    /* _this->_caffc_contained_type_id = = &{{ array.childType | c_name }}_type; */

    /* instantiate and set children */
    for (i = 0; i < s1; i++) {
        arr_child = (caffc_ptr) {{ array.childType | c_name }}_newa(
            {%- for i in range(2, array.arrayDimensions) -%}
                s{{ i }}
                {%- if not loop.last %}, {% endif -%}
            {%- endfor -%});
        caffc_obj_arr_set(_this, i, arr_child);
        if (_caffc_exception) { goto newArrayException; }

        arr_child = caffc_null;
    }

    _caffc_stack_frame_unregister(_caffc_locals);
    return _this;

newArrayException:
    _caffc_stack_frame_unregister(_caffc_locals);
    return caffc_null;
}
{%- endif %}{# array.arrayDimensions > 1 #}
{%- endfor %}{# for array in ctx.registeredArrays #}

#ifdef __cplusplus
}
#endif
