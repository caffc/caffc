#include "module_caffc.h"

{# we need to include all the modules to have the `init_module` and global
   vars definitions avalable -#}
{%- for module in program.modules.values() %}
#include "{{ module | c_global_header }}"
{%- endfor %}

/* ******************************************************************
 * CaffC Main Initialization
 * ******************************************************************/

/* Initializes the CaffC memory allocator, and calls for each module
 * its `init_module()` function. */
void caffc_init() {
  caffc_memory_init();
  if (_caffc_exception) return;
  {%- for module in program.initModulesSorted %}
  {{ module | c_name }}init_module();
  if (_caffc_exception) return;
  {%- endfor %}
}

/* Winds down the CaffC memory allocator. */
void caffc_done() {
  caffc_memory_done();
}

/* ******************************************************************
 * Global Variables
 * ******************************************************************/
caffc_ptr* _caffc_global_variables[] = {
{%- for globalVar in program.globalVariables %}
  &{{ globalVar | render }}{%if not loop.last %},{%endif%}
{%- endfor %}
};

/* ******************************************************************
 * CLASS types+inheritance
 * ******************************************************************/

/* NAME data ***************************************************** */
char* caffc_type_id_name[] = {
{%- for symbol in program.typeDefinitionSymbols %}
  /* {{ symbol.typeId }} */ "{{symbol.typeName}}"{%if not loop.last %},{%endif%}
{%- endfor %}
};

/* GC_COUNT data ************************************************* */
/* FIXME: move to u8? 200 fields is already excessive */
caffc_u32 caffc_type_id_gc_count[] = {
{%- for symbol in program.typeDefinitionSymbols %}
  /* {{ symbol.typeId }}: {{symbol.typeName}} */ {{symbol.gcFieldsCount}}{%if not loop.last %},{%endif%}
{%- endfor %}
};

{%- for caffc_type in program.typeDefinitionSymbols %}
{%- if caffc_type.implementedTypes.size > 0 %}
/* {{ caffc_type.typeName }} */
caffc_inheritance_data_{{ caffc_type.implementedTypes.size }} _caffc_inheritance_data_{{ caffc_type.typeId }} = {
    /* count */ {{ caffc_type.implementedTypes.size }},
    {
    {%- for implementedType in caffc_type.implementedTypes %}
    {{ implementedType.typeId }}{% if not loop.last %},{% endif %} /* {{ implementedType.typeName }} */
    {%- endfor %}
    }
};
{%- endif %}
{%- endfor %}

caffc_inheritance_data* caffc_type_id_inheritance[] = {
{%- for symbol in program.typeDefinitionSymbols %}
  {%- if symbol.implementedTypes.size > 0 %}
/* {{ symbol.typeId }}: {{symbol.typeName}} */ (caffc_inheritance_data*)&_caffc_inheritance_data_{{ symbol.typeId }}{%if not loop.last %},{%endif%}
  {%- else %}
/* {{ symbol.typeId }}: {{symbol.typeName}} */ caffc_null{%if not loop.last %},{%endif%}
  {%- endif %}
{%- endfor %}
};

/* ******************************************************************
 * STRING constants
 * ******************************************************************/

/*
 * All strings are written with the data serialized already. When referring
 * to a constant, a cast to `(caffc_str*)&{constant.name}` will be performed.
 * This ensures there's no time spent into instantiating _native_ CaffC constant
 * strings.
 */
{% for constant in program.stringConstants %}
caffc_str_{{ constant.bytesSize }} {{ constant.name }} = {
    /* _caffc_type_id */ CAFFC_STR_TYPE_ID,
    /* _caffc_flags */ 0,
    /* size */ {{ constant.bytesSize }},
    { {{ constant.valueAsBytes }} }
};
{% endfor %}