module main

native {
  #include <dirent.h>
  #include <stdio.h>
  #include <errno.h>
  #include <string.h>
}

class File {
  str name

  constructor(str name) {
    _this.name = name
  }

  compareTo(File other) -> i32 {
    return _this.name.compareTo(other.name)
  }
}

main(str[] args) -> i32 {
  str folderToList = "."

  if args.size() > 1 {
    folderToList = args[1]
  }

  ArrayList<File> files = list_files(folderToList)
  sort(files)

  for File f in files {
    print(f.name)
  }

  return 0
}

list_files(str path) -> ArrayList<File> {
  ArrayList<File> result = new ArrayList<File>(16)

  native {
    DIR *dir = caffc_null;
    struct dirent* ent = caffc_null;

    dir = opendir(path->_caffc_data);

    if (!dir) {
      caffc_throw_exception(strerror(errno));
      goto resource_cleanup;
    }

    while ((ent = readdir(dir)) != caffc_null) {
      main_add_item_to_list(result, ent->d_name);
    }

    if (errno) {
      caffc_throw_exception(strerror(errno));
    }

    resource_cleanup:
    if (dir) {
      closedir(dir);
    }
  }

  return result
}

add_item_to_list(ArrayList<File> list, ptr path) {
  str s = str.fromPtr(path)

  if (s.indexOf(".") == 0) {
    return // exclude hidden files
  }

  list.add(new File(s))
}

sort(ArrayList<File> file_list) -> void {
    for i32 i = 0; i < file_list.size(); i += 1 {
        for i32 j = 0; j < file_list.size() - i - 1; j += 1 {
            File f = file_list.get(j)
            if f.compareTo(file_list.get(j + 1)) > 0 {
                File temp = file_list.get(j)
                file_list.set(j, file_list.get(j + 1))
                file_list.set(j + 1, temp)
            }
        }
    }
}
