module main

use main.asserts

testArrayList() {
  ArrayList<I32> myList = new ArrayList<I32>(10)
  assertTrue(myList.isEmpty(), "new list should be empty")
  assertTrue(myList.size() == 0, "new list size should be 0")

  I32 a = new I32(10)
  I32 b = new I32(20)
  I32 c = new I32(30)

  myList.addAll(a)
  myList.addAll(b)
  myList.addAll(c)

  assertTrue(myList.isEmpty() == 0, "list should not be empty after add")
  assertTrue(myList.size() == 3, "list size should be 3 after 3 adds")

  I32 first = myList.get(0)
  assertTrue(first != null, "first element should not be null")
  assertTrue(first.value == 10, "first element should be 10")

  I32 second = myList.get(1)
  assertTrue(second.value == 20, "second element should be 20")

  I32 third = myList.get(2)
  assertTrue(third.value == 30, "third element should be 30")

  I32 updated = new I32(25)
  myList.set(1, updated)
  I32 secondAfterSet = myList.get(1)
  assertTrue(secondAfterSet.value == 25, "second element should be 25 after set")

  I32 removed = myList.remove(1)
  assertTrue(removed.value == 25, "removed element should be 25")
  assertTrue(myList.size() == 2, "list size should be 2 after remove")
  assertTrue(myList.get(0).value == 10, "first element should still be 10")
  assertTrue(myList.get(1).value == 30, "second element should be 30 after middle remove")
}

testHashDictStringLiterals() {
  HashDict<str, I32> myDict = new HashDict<str, I32>(10)
  assertTrue(myDict.isEmpty(), "new dict should be empty")
  assertTrue(myDict.size() == 0, "new dict size should be 0")

  myDict.put("one", new I32(1))
  myDict.put("two", new I32(2))
  myDict.put("three", new I32(3))

  assertTrue(myDict.size() == 3, "dict size should be 3")
  assertTrue(myDict.containsKey("one") == 1, "dict should contain key one")
  assertTrue(myDict.containsKey("three") == 1, "dict should contain key three")
  assertTrue(myDict.containsKey("missing") == 0, "dict should not contain missing key")

  I32 val = myDict.get("one")
  assertTrue(val != null, "value should not be null")
  assertTrue(val.value == 1, "dict[one] should be 1")

  I32 two = myDict.get("two")
  assertTrue(two.value == 2, "dict[two] should be 2")

  I32 three = myDict.get("three")
  assertTrue(three.value == 3, "dict[three] should be 3")

  myDict.put("one", new I32(100))
  I32 updated = myDict.get("one")
  assertTrue(updated.value == 100, "dict[one] should be 100 after update")
  assertTrue(myDict.size() == 3, "dict size should still be 3 after update")

  myDict.remove("two")
  assertTrue(myDict.size() == 2, "dict size should be 2 after remove")
}

testHashSetStringLiterals() {
  HashSet<str> mySet = new HashSet<str>(10)
  assertTrue(mySet.isEmpty(), "new set should be empty")
  assertTrue(mySet.size() == 0, "new set size should be 0")

  mySet.addAll("a")
  mySet.addAll("b")
  mySet.addAll("c")

  assertTrue(mySet.size() == 3, "set size should be 3")
  assertTrue(mySet.contains("a") == 1, "set should contain a")
  assertTrue(mySet.contains("c") == 1, "set should contain c")
  assertTrue(mySet.contains("d") == 0, "set should not contain d")

  mySet.addAll("b")
  assertTrue(mySet.size() == 3, "set size should still be 3 after duplicate add")

  bool removed = mySet.remove("b")
  assertTrue(removed == 1, "removing existing should return true")
  assertTrue(mySet.size() == 2, "set size should be 2 after remove")
}

testHashSetStrHeapObjects() {
  // Tests that heap-allocated str objects with same content are found
  // via hash+equals virtual dispatch, not just pointer equality
  HashSet<str> mySet = new HashSet<str>(8)

  str a = new str(5)
  str b = new str(5)

  // a and b are different heap allocations but same content "aaaaa"
  mySet.addAll(a)
  assertTrue(mySet.size() == 1, "set size should be 1 after adding a")
  assertTrue(mySet.contains(a) == 1, "set should contain a")

  // b has same content as a but is a different heap allocation
  // equals() should return true, so contains() should find it
  assertTrue(mySet.contains(b) == 1, "set should contain b (same content as a)")
  assertTrue(mySet.size() == 1, "set size should still be 1 (duplicate content)")

  mySet.addAll(b)
  assertTrue(mySet.size() == 1, "adding b should leave size 1 (same content)")

  str c = new str(6)

  // c has different length than a and b, so different content
  assertTrue(mySet.contains(c) == 0, "set should not contain c (different content)")

  bool removed = mySet.remove(a)
  assertTrue(removed == 1, "removing a should return true")
  assertTrue(mySet.size() == 0, "set size should be 0 after remove")
}

testHashDictStrHeapObjects() {
  // Same test but for HashDict
  HashDict<str, I32> myDict = new HashDict<str, I32>(8)

  str key1 = new str(3)
  str key2 = new str(3)

  myDict.put(key1, new I32(42))
  assertTrue(myDict.size() == 1, "dict size should be 1")
  assertTrue(myDict.containsKey(key1) == 1, "dict should contain key1")

  // key2 has same content as key1 but different allocation
  // equals() should find it via virtual dispatch
  assertTrue(myDict.containsKey(key2) == 1, "dict should contain key2 (same content)")
  I32 val = myDict.get(key2)
  assertTrue(val != null, "value should not be null")
  assertTrue(val.value == 42, "dict.get(key2) should be 42")

  // key3 has different content (different length)
  str key3 = new str(4)
  assertTrue(myDict.containsKey(key3) == 0, "dict should not contain key3")
  assertTrue(myDict.size() == 1, "dict size should still be 1")
}

testHashSetI32Boxing() {
  // Tests that boxing classes work with HashSet via hash/equals
  HashSet<I32> mySet = new HashSet<I32>(8)

  I32 a = new I32(42)
  I32 b = new I32(99)
  I32 c = new I32(7)

  mySet.addAll(a)
  mySet.addAll(b)
  mySet.addAll(c)

  assertTrue(mySet.size() == 3, "set size should be 3")
  assertTrue(mySet.contains(a) == 1, "set should contain a")
  assertTrue(mySet.contains(b) == 1, "set should contain b")
  assertTrue(mySet.contains(c) == 1, "set should contain c")

  // d is a different heap allocation with same value as a
  I32 d = new I32(42)
  assertTrue(mySet.contains(d) == 1, "set should contain d (same value via equals)")
  assertTrue(mySet.size() == 3, "set size should still be 3 after duplicate add")

  mySet.addAll(d)
  assertTrue(mySet.size() == 3, "adding duplicate should leave size 3")

  bool removed = mySet.remove(b)
  assertTrue(removed == 1, "removing existing should return true")
  assertTrue(mySet.size() == 2, "set size should be 2 after remove")
}

testHashDictI32Boxing() {
  // Tests that boxing classes work with HashDict via hash/equals
  HashDict<I32, str> myDict = new HashDict<I32, str>(8)

  I32 key1 = new I32(100)
  I32 key2 = new I32(100)

  myDict.put(key1, new str(5))
  assertTrue(myDict.size() == 1, "dict size should be 1")
  assertTrue(myDict.containsKey(key1) == 1, "dict should contain key1")

  // key2 has same value as key1 but different allocation
  // equals() should find it via virtual dispatch
  assertTrue(myDict.containsKey(key2) == 1, "dict should contain key2 (same value)")
  assertTrue(myDict.get(key2) != null, "dict.get(key2) should not be null")

  // key3 has different value
  I32 key3 = new I32(200)
  assertTrue(myDict.containsKey(key3) == 0, "dict should not contain key3")
  assertTrue(myDict.size() == 1, "dict size should still be 1")

  myDict.remove(key2)
  assertTrue(myDict.size() == 0, "dict size should be 0 after remove")
}


testArrayListOperators() {
  ArrayList<I32> myList = new ArrayList<I32>(4)
  I32 a = new I32(1)
  I32 b = new I32(2)
  I32 c = new I32(3)

  myList += a
  myList += b
  assertTrue(myList.size() == 2, "list += should append")

  List<I32> copied = myList + c
  assertTrue(copied.size() == 3, "list + should append into a new list")
  assertTrue(myList.size() == 2, "list + must not mutate the original")
  assertTrue(copied.get(2).value == 3, "new list should contain appended element")

  List<I32> withoutB = myList - b
  assertTrue(withoutB.size() == 1, "list - should remove into a new list")
  assertTrue(myList.size() == 2, "list - must not mutate the original")
  assertTrue(withoutB.get(0).value == 1, "remaining element should be 1")

  myList -= b
  assertTrue(myList.size() == 1, "list -= should remove from self")
  assertTrue(myList.get(0).value == 1, "remaining element after -= should be 1")
}

testHashDictOperators() {
  HashDict<str, I32> left = new HashDict<str, I32>(4)
  HashDict<str, I32> right = new HashDict<str, I32>(4)
  left.put("a", new I32(1))
  left.put("b", new I32(2))
  right.put("b", new I32(20))
  right.put("c", new I32(3))

  Dict<str, I32> merged = left + right
  assertTrue(merged.size() == 3, "dict + should merge into a new dict")
  assertTrue(left.size() == 2, "dict + must not mutate the left dict")
  assertTrue(merged.get("b").value == 20, "dict + should overwrite with right values")
  assertTrue(merged.get("c").value == 3, "dict + should include right-only keys")

  left += right
  assertTrue(left.size() == 3, "dict += should merge into self")
  assertTrue(left.get("c").value == 3, "dict += should include right-only keys")

  HashDict<str, I32> removeKeys = new HashDict<str, I32>(2)
  removeKeys.put("b", new I32(0))
  Dict<str, I32> withoutB = left - removeKeys
  assertTrue(withoutB.size() == 2, "dict - should remove keys into a new dict")
  assertTrue(left.size() == 3, "dict - must not mutate the left dict")
  assertTrue(withoutB.containsKey("b") == 0, "dict - should drop matching keys")

  left -= removeKeys
  assertTrue(left.size() == 2, "dict -= should remove keys from self")
  assertTrue(left.containsKey("b") == 0, "dict -= should drop matching keys")
}

testHashDictIteration() {
  HashDict<str, I32> myDict = new HashDict<str, I32>(8)
  myDict.put("a", new I32(1))
  myDict.put("b", new I32(2))
  myDict.put("c", new I32(3))

  i32 count = 0
  i32 sum = 0
  str key = null
  I32 val = null
  for DictEntry<str, I32> entry in myDict {
    count = count + 1
    key = entry.key
    val = entry.value
    sum = sum + val.value
    assertTrue(key != null, "dict entry key should not be null")
    assertTrue(val != null, "dict entry value should not be null")
    assertTrue(myDict.get(key).value == val.value, "entry should match dict get")
  }
  assertTrue(count == 3, "dict for-in should yield one entry per key")
  assertTrue(sum == 6, "dict for-in values should sum to 6")
}

testHashSetOperators() {
  HashSet<str> mySet = new HashSet<str>(4)
  mySet += "a"
  mySet += "b"
  assertTrue(mySet.size() == 2, "set += should insert")

  Set<str> withC = mySet + "c"
  assertTrue(withC.size() == 3, "set + should insert into a new set")
  assertTrue(mySet.size() == 2, "set + must not mutate the original")
  assertTrue(withC.contains("c") == 1, "new set should contain c")

  Set<str> withoutB = mySet - "b"
  assertTrue(withoutB.size() == 1, "set - should remove into a new set")
  assertTrue(mySet.size() == 2, "set - must not mutate the original")
  assertTrue(withoutB.contains("b") == 0, "new set should not contain b")

  mySet -= "b"
  assertTrue(mySet.size() == 1, "set -= should remove from self")
  assertTrue(mySet.contains("b") == 0, "set should not contain b after -=")
}

main() {
  testArrayList()
  testArrayListOperators()
  testHashDictStringLiterals()
  testHashDictOperators()
  testHashDictIteration()
  testHashSetStringLiterals()
  testHashSetOperators()
  testHashSetStrHeapObjects()
  testHashDictStrHeapObjects()
  testHashSetI32Boxing()
  testHashDictI32Boxing()
  print("All collection tests passed!")
  exit(0)
}
