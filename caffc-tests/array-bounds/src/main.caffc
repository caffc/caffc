module main

use main.asserts

class Item {
  i32 value

  constructor(i32 value) {
    _this.value = value
  }
}

expectGetBounds(str message) {
  print(message)
  exit(1)
}

testU8Bounds() {
  u8[] arr = new u8[2]
  arr[0] = 10
  arr[1] = 20
  assertTrue(arr[0] == 10, "u8 valid get 0")
  assertTrue(arr[1] == 20, "u8 valid get 1")

  i32 threw = 0
  try {
    u8 x = arr[2]
    expectGetBounds("u8 get OOB should throw")
  } catch (Exception e) {
    threw = 1
    assertEqual("invalid index in get operation", e.message(), "u8 get OOB message")
  }
  assertTrue(threw == 1, "u8 get OOB should throw")

  threw = 0
  try {
    arr[2] = 30
    expectGetBounds("u8 set OOB should throw")
  } catch (Exception e) {
    threw = 1
    assertEqual("invalid index in set operation", e.message(), "u8 set OOB message")
  }
  assertTrue(threw == 1, "u8 set OOB should throw")

  threw = 0
  try {
    u8 x = arr[-1]
    expectGetBounds("u8 negative get should throw")
  } catch (Exception e) {
    threw = 1
    assertEqual("invalid index in get operation", e.message(), "u8 negative get message")
  }
  assertTrue(threw == 1, "u8 negative get should throw")
}

testI8Bounds() {
  i8[] arr = new i8[1]
  arr[0] = -5
  assertTrue(arr[0] == -5, "i8 valid get")

  i32 threw = 0
  try {
    i8 x = arr[1]
  } catch (Exception e) {
    threw = 1
    assertEqual("invalid index in get operation", e.message(), "i8 get OOB message")
  }
  assertTrue(threw == 1, "i8 get OOB should throw")

  threw = 0
  try {
    arr[1] = 1
  } catch (Exception e) {
    threw = 1
    assertEqual("invalid index in set operation", e.message(), "i8 set OOB message")
  }
  assertTrue(threw == 1, "i8 set OOB should throw")
}

