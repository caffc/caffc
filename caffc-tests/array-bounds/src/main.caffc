testObjBounds() {
  Item[] arr = new Item[1]
  arr[0] = new Item(7)
  assertTrue(arr[0].value == 7, "obj valid get")

  i32 threw = 0
  try {
    Item x = arr[1]
  } catch (Exception e) {
    threw = 1
    assertEqual("invalid index in get operation", e.message(), "obj get OOB message")
  }
  assertTrue(threw == 1, "obj get OOB should throw")

  threw = 0
  try {
    arr[1] = new Item(8)
  } catch (Exception e) {
    threw = 1
    assertEqual("invalid index in set operation", e.message(), "obj set OOB message")
  }
  assertTrue(threw == 1, "obj set OOB should throw")

  threw = 0
  try {
    Item x = arr[-1]
  } catch (Exception e) {
    threw = 1
    assertEqual("invalid index in get operation", e.message(), "obj negative get message")
  }
  assertTrue(threw == 1, "obj negative get should throw")
}

main() {
  testU8Bounds()
  testI8Bounds()
  testU16Bounds()
  testI16Bounds()
  testU32Bounds()
  testI32Bounds()
  testU64Bounds()
  testI64Bounds()
  testF32Bounds()
  testF64Bounds()
  testObjBounds()
  print("All array bounds tests passed!")
  exit(0)
}
