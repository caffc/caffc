module main

str x = "hello world"
ArrayList<str> items = new ArrayList<str>(4)
ArrayList<str> nullArray

module_init() {
  print("module initialized")

  items.addAll("this")
  items.addAll("is")
  items.addAll("a")
  items.addAll("test")
}

unit_init() {
  print("unit initialized")
}

main(str[] args) -> i32 {
  print(x)

  for str item in items {
    print(item)
  }

  return 0
}

