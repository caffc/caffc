module main

str x = "hello world"
ArrayList<str> items = new ArrayList<str>(4)
ArrayList<str> nullArray

init_module() {
  print("module initialized")

  items.add("this")
  items.add("is")
  items.add("a")
  items.add("test")
}

init_unit() {
  print("unit initialized")
}

main(str[] args) -> i32 {
  print(x)

  for str item in items {
    print(item)
  }

  return 0
}

