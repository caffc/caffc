module caffc

#public class U16 implements HasHash {
    u16 value

    #public constructor(u16 value) {
        _this.value = value
    }

    #public toU16() -> u16 {
        return _this.value
    }

    #public hash() -> i32 {
        return _this.value
    }

    #public equals(HasEquals other) -> bool {
        if other not instanceof U16 {
            return 0
        }
        return _this.value == ((U16)other).value
    }
}
