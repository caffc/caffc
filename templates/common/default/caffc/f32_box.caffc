module caffc

#public class F32 implements HasHash {
    f32 value

    #public constructor(f32 value) {
        _this.value = value
    }

    #public toF32() -> f32 {
        return _this.value
    }

    #public hash() -> i32 {
        return _this.value
    }

    #public equals(HasEquals other) -> bool {
        if other not instanceof F32 {
            return 0
        }
        return _this.value == ((F32)other).value
    }
}
