module caffc

#public class F64 implements HasHash {
    f64 value

    #public constructor(f64 value) {
        _this.value = value
    }

    #public toF64() -> f64 {
        return _this.value
    }

    #public hash() -> i32 {
        return (i32) _this.value
    }

    #public equals(HasEquals other) -> bool {
        if other not instanceof F64 {
            return 0
        }
        return _this.value == ((F64)other).value
    }
}
