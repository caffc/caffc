module caffc

#public class I32 implements HasHash {
    i32 value

    #public constructor(i32 value) {
        _this.value = value
    }

    #public toI32() -> i32 {
        return _this.value
    }

    #public hash() -> i32 {
        return _this.value
    }

    #public equals(HasEquals other) -> bool {
        if other not instanceof I32 {
            return 0
        }
        return _this.value == ((I32)other).value
    }
}
