module caffc

#public class I16 implements HasHash {
    i16 value

    #public constructor(i16 value) {
        _this.value = value
    }

    #public toI16() -> i16 {
        return _this.value
    }

    #public hash() -> i32 {
        return _this.value
    }

    #public equals(HasEquals other) -> bool {
        if other not instanceof I16 {
            return 0
        }
        return _this.value == ((I16)other).value
    }
}
