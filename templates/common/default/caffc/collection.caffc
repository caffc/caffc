module caffc

interface Iterator<T> {
  hasNext() -> bool
  next() -> T
}

interface Iterable<T> {
  newIterator() -> Iterator<T>
}

interface Collection<T> extends Iterable<T> {
  isEmpty() -> bool
  size() -> i32
}

interface List<T> extends Collection<T> {
  get(i32 index) -> T
  set(i32 index, T value)
  remove(i32 index) -> T
  indexOf(T value) -> i32

  // `+` / `-`: non-mutating copies
  add(T value) -> List<T>
  substract(T value) -> List<T>
  // `+=` / `-=`: mutate and return _this
  addAll(T value) -> List<T>
  substractAll(T value) -> List<T>
}

#public class DictEntry<K, V> {
  K key
  V value

  #public constructor(K key, V value) {
    _this.key = key
    _this.value = value
  }
}

interface Dict<K is HasHash, V> extends Collection<DictEntry<K, V>> {
  get(K key) -> V
  put(K key, V value)
  remove(K key) -> V
  containsKey(K key) -> bool

  // `+` / `-`: non-mutating copies (merge / remove keys present in other)
  add(Dict<K, V> other) -> Dict<K, V>
  substract(Dict<K, V> other) -> Dict<K, V>
  // `+=` / `-=`: mutate and return _this
  addAll(Dict<K, V> other) -> Dict<K, V>
  substractAll(Dict<K, V> other) -> Dict<K, V>
}

interface Set<T is HasHash> extends Collection<T> {
  remove(T value) -> bool
  contains(T value) -> bool

  // `+` / `-`: non-mutating copies
  add(T value) -> Set<T>
  substract(T value) -> Set<T>
  // `+=` / `-=`: mutate and return _this
  addAll(T value) -> Set<T>
  substractAll(T value) -> Set<T>
}
