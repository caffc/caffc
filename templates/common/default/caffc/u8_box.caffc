module caffc

#public class U8 implements HasHash {
    u8 value

    #public constructor(u8 value) {
        _this.value = value
    }

    #public toU8() -> u8 {
        return _this.value
    }

    #public hash() -> i32 {
        return _this.value
    }

    #public equals(HasEquals other) -> bool {
        if other not instanceof U8 {
            return 0
        }
        return _this.value == ((U8)other).value
    }
}
