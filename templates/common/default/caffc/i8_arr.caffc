module caffc

_caffc_i8_arr_size(i32 size) -> i32 {
  i32 result

  native {
    result = (caffc_i32) (sizeof(caffc_i8) * size + sizeof(caffc_i8_arr));
  }

  return result
}

/**
 * An array of signed chars. This is the implementation
 * behind the i8[].
 */
#caffc_array("caffc_i8")
class i8_arr {
  u32 size

  constructor(i32 size) {
    _this.size = size
  }

  set(i32 index, i8 value) {
    native {
      _this->_caffc_data[index] = value;
    }
  }

  get(i32 index) -> i8 {
    i8 result

    native {
      result = _this->_caffc_data[index];
    }

    return result
  }
}
