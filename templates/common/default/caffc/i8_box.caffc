module caffc

#public class I8 implements HasHash {
    i8 value

    #public constructor(i8 value) {
        _this.value = value
    }

    #public toI8() -> i8 {
        return _this.value
    }

    #public hash() -> i32 {
        return _this.value
    }

    #public equals(HasEquals other) -> bool {
        if other not instanceof I8 {
            return 0
        }
        return _this.value == ((I8)other).value
    }
}
