module caffc

_caffc_i64_arr_size(i32 size) -> i32 {
  i32 result

  native {
    result = (caffc_i32) (sizeof(caffc_i64) * size + sizeof(caffc_i64_arr));
  }

  return result
}

/**
 * An array of signed 64-bit ints. This is the implementation
 * behind the i64[].
 */
#caffc_array("caffc_i64")
class i64_arr {
  u32 size

  constructor(i32 size) {
    _this.size = size
  }

  set(i32 index, i64 value) {
    native {
      _this->_caffc_data[index] = value;
    }
  }

  get(i32 index) -> i64 {
    i64 result

    native {
      result = _this->_caffc_data[index];
    }

    return result
  }
}
