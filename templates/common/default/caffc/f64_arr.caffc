module caffc

_caffc_f64_arr_size(i32 size) -> i32 {
  i32 result

  native {
    result = (caffc_i32) (sizeof(caffc_f64) * size + sizeof(caffc_f64_arr));
  }

  return result
}

/**
 * An array of 64-bit doubles. This is the implementation
 * behind the f64[].
 */
#caffc_array("caffc_f64")
class f64_arr {
  u32 size

  constructor(i32 size) {
    _this.size = size
  }

  set(i32 index, f64 value) {
    native {
      _this->_caffc_data[index] = value;
    }
  }

  get(i32 index) -> f64 {
    f64 result

    native {
      result = _this->_caffc_data[index];
    }

    return result
  }
}
