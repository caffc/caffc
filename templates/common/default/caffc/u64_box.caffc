module caffc

#public class U64 implements HasHash {
    u64 value

    #public constructor(u64 value) {
        _this.value = value
    }

    #public toU64() -> u64 {
        return _this.value
    }

    #public hash() -> i32 {
        return (i32) _this.value
    }

    #public equals(HasEquals other) -> bool {
        if other not instanceof U64 {
            return 0
        }
        return _this.value == ((U64)other).value
    }
}
