module caffc

_caffc_i32_arr_size(i32 size) -> i32 {
  i32 result

  native {
    result = (caffc_i32) (sizeof(caffc_i32) * size + sizeof(caffc_i32_arr));
  }

  return result
}

/**
 * An array of signed 32-bit ints. This is the implementation
 * behind the i32[].
 */
#caffc_array("caffc_i32")
class i32_arr {
  u32 size

  constructor(i32 size) {
    _this.size = size
  }

  set(i32 index, i32 value) {
    native {
      _this->_caffc_data[index] = value;
    }
  }

  get(i32 index) -> i32 {
    i32 result

    native {
      result = _this->_caffc_data[index];
    }

    return result
  }
}
