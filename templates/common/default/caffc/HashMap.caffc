module caffc

use caffc.collection

#public class HashDict<K is HasHash, V> implements Dict<K, V> {
    K[] _keys
    V[] _values
    i32 _size
    i32 _capacity

    #public constructor(i32 capacity) {
        _this._size = 0
        _this._capacity = capacity
        _this._keys = new K[capacity]
        _this._values = new V[capacity]
    }

    #public _findIndex(K key, i32 keyHash) -> i32 {
        i32 i = 0
        while i < _this._capacity {
            switch {
                case _this._keys[i] != null: {
                    i32 existingHash = _this._keys[i].hash()
                    if existingHash == keyHash and _this._keys[i].equals(key) == 1 {
                        return i
                    }
                }
            }
            i = i + 1
        }
        return -1
    }

    #public _tryPutAt(K key, V value, i32 index) {
        _this._keys[index] = key
        _this._values[index] = value
        _this._size = _this._size + 1
    }

    #public get(K key) -> V {
        i32 keyHash = key.hash()
        i32 index = _this._findIndex(key, keyHash)
        if index == -1 {
            return null
        }
        return _this._values[index]
    }

    #public put(K key, V value) {
        i32 keyHash = key.hash()
        i32 existing = _this._findIndex(key, keyHash)
        if existing != -1 {
            _this._values[existing] = value
            return
        }
        if (u32) _this._size >= (u32) _this._capacity {
            _this._grow()
        }
        i32 free = _this._findFirstFreeSlot()
        _this._keys[free] = key
        _this._values[free] = value
        _this._size = _this._size + 1
    }

    #public remove(K key) -> V {
        i32 keyHash = key.hash()
        i32 index = _this._findIndex(key, keyHash)
        if index == -1 {
            return null
        }
        V result = _this._values[index]
        _this._keys[index] = null
        _this._values[index] = null
        _this._size = _this._size - 1
        return result
    }

    #public containsKey(K key) -> bool {
        i32 keyHash = key.hash()
        return _this._findIndex(key, keyHash) != -1
    }

    #public add(Dict<K, V> other) -> Dict<K, V> {
        HashDict<K, V> result = new HashDict<K, V>(_this._size + other.size() + 1)
        result.addAll(_this)
        result.addAll(other)
        return result
    }

    #public addAll(Dict<K, V> other) -> Dict<K, V> {
        HashDict<K, V> o = (HashDict<K, V>) other
        i32 i = 0
        while i < o._capacity {
            if o._keys[i] != null {
                _this.put(o._keys[i], o._values[i])
            }
            i = i + 1
        }
        return _this
    }

    #public substract(Dict<K, V> other) -> Dict<K, V> {
        HashDict<K, V> result = new HashDict<K, V>(_this._size + 1)
        result.addAll(_this)
        result.substractAll(other)
        return result
    }

    #public substractAll(Dict<K, V> other) -> Dict<K, V> {
        HashDict<K, V> o = (HashDict<K, V>) other
        i32 i = 0
        while i < o._capacity {
            if o._keys[i] != null {
                _this.remove(o._keys[i])
            }
            i = i + 1
        }
        return _this
    }

    #public isEmpty() -> bool {
        return _this._size == 0
    }

    #public size() -> i32 {
        return _this._size
    }

    #public newIterator() -> Iterator<DictEntry<K, V>> {
        return new HashDictIterator<K, V>(_this)
    }

    #public _findFirstFreeSlot() -> i32 {
        i32 i = 0
        while i < _this._capacity {
            if _this._keys[i] == null {
                return i
            }
            i = i + 1
        }
        return -1
    }

    _reinsert(K key, V value) {
        i32 keyHash = key.hash()
        i32 found = _this._findIndex(key, keyHash)
        switch {
            case found != -1: {
                _this._tryPutAt(key, value, found)
            }
            default: {
                i32 free = _this._findFirstFreeSlot()
                _this._tryPutAt(key, value, free)
            }
        }
    }

    _grow() {
        i32 oldCapacity = _this._capacity
        K[] oldKeys = _this._keys
        V[] oldValues = _this._values
        _this._capacity = oldCapacity * 2
        _this._keys = new K[_this._capacity]
        _this._values = new V[_this._capacity]
        _this._size = 0
        i32 i = 0
        while i < oldCapacity {
            if oldKeys[i] != null {
                _this._reinsert(oldKeys[i], oldValues[i])
            }
            i = i + 1
        }
    }
}

class HashDictIterator<K is HasHash, V> implements Iterator<DictEntry<K, V>> {
    HashDict<K, V> _collection
    i32 _index
    i32 _yielded

    #public constructor(HashDict<K, V> coll) {
        _this._collection = coll
        _this._index = 0
        _this._yielded = 0
    }

    #public hasNext() -> bool {
        return _this._yielded < _this._collection._size
    }

    #public next() -> DictEntry<K, V> {
        if not _this.hasNext() {
            raise("iterator out of bounds")
        }
        while _this._index < _this._collection._capacity {
            if _this._collection._keys[_this._index] != null {
                DictEntry<K, V> result = new DictEntry<K, V>(
                    _this._collection._keys[_this._index],
                    _this._collection._values[_this._index]
                )
                _this._index = _this._index + 1
                _this._yielded = _this._yielded + 1
                return result
            }
            _this._index = _this._index + 1
        }
        raise("iterator out of bounds")
    }
}

/**
 * Immutable empty Dict. Mutating methods raise. Used as the shared empty kwargs
 * instance when a call site has no keyword arguments.
 */
#public class EmptyReadonlyDict<K is HasHash, V> implements Dict<K, V> {
    #public constructor() {
    }

    #public get(K key) -> V {
        return null
    }

    #public put(K key, V value) {
        raise("EmptyReadonlyDict is readonly")
    }

    #public remove(K key) -> V {
        raise("EmptyReadonlyDict is readonly")
    }

    #public containsKey(K key) -> bool {
        return 0
    }

    #public add(Dict<K, V> other) -> Dict<K, V> {
        HashDict<K, V> result = new HashDict<K, V>(other.size() + 1)
        result.addAll(other)
        return result
    }

    #public addAll(Dict<K, V> other) -> Dict<K, V> {
        raise("EmptyReadonlyDict is readonly")
    }

    #public substract(Dict<K, V> other) -> Dict<K, V> {
        return _this
    }

    #public substractAll(Dict<K, V> other) -> Dict<K, V> {
        raise("EmptyReadonlyDict is readonly")
    }

    #public isEmpty() -> bool {
        return 1
    }

    #public size() -> i32 {
        return 0
    }

    #public newIterator() -> Iterator<DictEntry<K, V>> {
        return new EmptyReadonlyDictIterator<K, V>()
    }
}

class EmptyReadonlyDictIterator<K is HasHash, V> implements Iterator<DictEntry<K, V>> {
    #public constructor() {
    }

    #public hasNext() -> bool {
        return 0
    }

    #public next() -> DictEntry<K, V> {
        raise("iterator out of bounds")
    }
}

// Shared empty kwargs dict for calls with no keyword arguments.
Dict<str, obj> EMPTY_KWARGS = new EmptyReadonlyDict<str, obj>()
