module caffc

#public class U32 implements HasHash {
    u32 value

    #public constructor(u32 value) {
        _this.value = value
    }

    #public toU32() -> u32 {
        return _this.value
    }

    #public hash() -> i32 {
        return _this.value
    }

    #public equals(HasEquals other) -> bool {
        if other not instanceof U32 {
            return 0
        }
        return _this.value == ((U32)other).value
    }
}
