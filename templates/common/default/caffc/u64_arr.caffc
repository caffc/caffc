module caffc

_caffc_u64_arr_size(i32 size) -> i32 {
  i32 result

  native {
    result = (caffc_i32) (sizeof(caffc_u64) * size + sizeof(caffc_u64_arr));
  }

  return result
}

/*
 * An array of unsigned 64-bit ints. This is the implementation
 * behind the u64[].
 */
#public #caffc_array("caffc_u64")
class u64_arr {
  u32 size
  ptr _caffc_data    // really declared as an caffc_u64[] in the C code

  #public
  constructor(i32 size) {
    _this.size = size
  }

  /*
   * Sets the value at the given index.
   */
  #public
  set(i32 index, u64 value) {
    if (u32) index >= _this.size {
      throw new Exception("invalid index in set operation", null)
    }

    native {
      _this->_caffc_data[index] = value;
    }
  }

  /*
   * Gets the value at the given index.
   */
  #public
  get(i32 index) -> u64 {
    if (u32) index >= _this.size {
      throw new Exception("invalid index in get operation", null)
    }

    u64 result

    native {
      result = _this->_caffc_data[index];
    }

    return result
  }
}
