module caffc

_caffc_f32_arr_size(i32 size) -> i32 {
  i32 result

  native {
    result = (caffc_i32) (sizeof(caffc_f32) * size + sizeof(caffc_f32_arr));
  }

  return result
}

/**
 * An array of 32-bit floats. This is the implementation
 * behind the f32[].
 */
#caffc_array("caffc_f32")
class f32_arr {
  u32 size

  constructor(i32 size) {
    _this.size = size
  }

  set(i32 index, f32 value) {
    native {
      _this->_caffc_data[index] = value;
    }
  }

  get(i32 index) -> f32 {
    f32 result

    native {
      result = _this->_caffc_data[index];
    }

    return result
  }
}
