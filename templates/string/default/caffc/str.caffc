module caffc

native {
  /**
   * strcmp() with CaffC semantics, without a dependency on libC.
   */
  caffc_i32 caffc_strcmp(caffc_u8* left_string, caffc_u8* right_string) {
    while (*left_string && *right_string && *left_string == *right_string) {
      left_string++;
      right_string++;
    }

    return *left_string - *right_string;
  }

  /**
   * indexOf() with CaffC semantics, without a dependency on libC
   */
  caffc_i32 caffc_index_of(caffc_u8* haystack, caffc_i32 haystack_len,
                           caffc_u8* needle, caffc_i32 needle_len) {
    caffc_i32 i, j;

    if (needle_len == 0) return 0;
    if (haystack_len < needle_len) return -1;

    for (i = 0; i <= haystack_len - needle_len; ++i) {
      for (j = 0; j < needle_len; ++j) {
          if (haystack[i + j] != needle[j]) break;
      }
      if (j == needle_len) return i;
    }

    return -1;
  }

  /**
   * memcpy() with CaffC semantics, without a dependency on libC
   */
  void caffc_memcpy(caffc_ptr dest, caffc_ptr src, caffc_i32 size) {
    caffc_u8* destPtr = (caffc_u8*) dest;
    caffc_u8* srcPtr = (caffc_u8*) src;
    caffc_i32 i;

    for (i = 0; i < size; i++) {
      destPtr[i] = srcPtr[i];
    }
  }

  /**
   * strlen() with CaffC semantics, without a dependency on libC
   */
  caffc_i32 caffc_strlen(caffc_ptr data) {
    caffc_i32 result = 0;

    while (*((char*)data)) {
      result += 1;
      data = (caffc_ptr) (((char*)data) + 1);
    }

    return result;
  }
}

_caffc_str_size(i32 size) -> i32 {
  i32 result

  native {
    result = (caffc_i32) (sizeof(caffc_u8) * size + sizeof(caffc_str));
  }

  return result
}

/**
 * A basic string. This implementation UTF-8 strings. Implicitly size()/get() deal
 * with bytes. codePoints are also available to be retrieved, and the graphene
 * length can be calculated.
 */
#public #caffc_array("caffc_u8")
class str implements HasHash {
  i32 _byte_length   // size in bytes, including nul byte. this only holds ASCII strings
  ptr _caffc_data    // really declared as an caffc_u8[] in the C code

  constructor(i32 size) {
    if size <= 0 {
      raise("invalid string size.")
    }

    _this._byte_length = size
  }

  /**
   * Creates a copy of the bytes until the first nul byte and creates a new `str` instance.
   * The `ptr` reference isn't stored internally, and a copy of the string will be made.
   */
  #public
  static fromPtr(ptr data) -> str {
    u32 byte_length
    str result

    native {
      byte_length = caffc_strlen(data) + 1;
    }

    result = new str((i32) byte_length)

    native {
      caffc_memcpy(result->_caffc_data, data, byte_length);
    }

    return result
  }

  #public
  static fromPtrBuffer(ptr data, i32 byte_length) -> str {
    str result = new str(byte_length + 1)

    native {
      caffc_memcpy(result->_caffc_data, data, byte_length);
    }

    return result
  }

  /**
   * Concatenates the current `str`, with the other `str`, into a new `str`
   * instance.
   */
  #public
  add(str other) -> str {
    if not other {
      raise("illegal null argument")
    }

    str result = new str(_this._byte_length + other._byte_length - 1)

    native {
      caffc_memcpy(result->_caffc_data, _this->_caffc_data, _this->_byte_length - 1);
      caffc_memcpy(result->_caffc_data + _this->_byte_length - 1,
                   other->_caffc_data, other->_byte_length); /* this copies also the nul byte */
    }

    return result
  }

  /**
   * Slices the current `str` into a new `str`. `start` and `end` positions are
   * character indexes (they can be negative). `0` for the `end_index` means
   * `_this.size()`
   */
  #public
  slice(i32 start_index, i32 end_index) -> str {
      if start_index < 0 {
        start_index = (i32) _this._byte_length + start_index - 1
      }

      if (u32) start_index >= (u32) _this._byte_length {
        raise("start_index out of bounds")
      }

      if end_index <= 0 {
        end_index = (i32) _this._byte_length + end_index - 1
      }

      if (u32) end_index > (u32) _this._byte_length {
        raise("end_index out of bounds")
      }

      if start_index > end_index {
        raise("start_index > end_index")
      }

      str result = new str(end_index - start_index + 1)

      native {
        caffc_memcpy(result->_caffc_data,
                     _this->_caffc_data + start_index, result->_byte_length - 1);
        result->_caffc_data[result->_byte_length - 1] = 0;
      }

      return result
  }

  /**
   * Half-open byte range `[fromInclusive, toExclusive)`, Python-style.
   * Negative indexes count from the end (`-1` is the last byte). Out-of-range
   * bounds are clamped. Prefer the sugar {@code s[from:to]} which calls this.
   */
  #public
  range(i32 fromInclusive, i32 toExclusive) -> str {
    i32 len = _this.size()

    if fromInclusive < 0 {
      fromInclusive = len + fromInclusive
    }

    if toExclusive < 0 {
      toExclusive = len + toExclusive
    }

    if fromInclusive < 0 {
      fromInclusive = 0
    }

    if toExclusive < 0 {
      toExclusive = 0
    }

    if fromInclusive > len {
      fromInclusive = len
    }

    if toExclusive > len {
      toExclusive = len
    }

    if fromInclusive >= toExclusive {
      return ""
    }

    i32 copyLen = toExclusive - fromInclusive
    str result = new str(copyLen + 1)

    native {
      caffc_memcpy(result->_caffc_data,
                   _this->_caffc_data + fromInclusive, copyLen);
      result->_caffc_data[copyLen] = 0;
    }

    return result
  }

  /**
   * Returns the byte at the given index.
   */
  #public
  get(i32 index) -> u8 {
    if index < 0 {
      index = (i32) _this._byte_length + index
    }

    if (u32) index >= (u32) _this._byte_length {
      raise("index out of bounds")
    }

    u32 result

    native {
      result = (caffc_u32) _this->_caffc_data[index];
    }

    return result
  }

  /*
   * Returns the code point at the given byte index.
   * On invalid / truncated UTF-8, returns U+FFFD and advances one byte.
   */
  #public
  getCodePoint(i32 index) -> u32 value, i32 nextByteIndex {
    i32 len = _this.size()
    u8 b0
    u8 b1
    u8 b2
    u8 b3
    u32 cp

    if index < 0 or index >= len {
      raise("index out of bounds")
    }

    b0 = _this.get(index)

    switch {
      // ASCII
      case (b0 & 0x80) == 0: {
        return (u32) b0, index + 1
      }
      // 2-byte sequence: 110xxxxx 10xxxxxx
      case (b0 & 0xE0) == 0xC0: {
        if index + 1 >= len {
          return 0xFFFD, index + 1
        }
        b1 = _this.get(index + 1)
        if (b1 & 0xC0) != 0x80 {
          return 0xFFFD, index + 1
        }
        cp = ((u32) (b0 & 0x1F) << 6) | (u32) (b1 & 0x3F)
        if cp < 0x80 {
          return 0xFFFD, index + 1
        }
        return cp, index + 2
      }
      // 3-byte sequence: 1110xxxx 10xxxxxx 10xxxxxx
      case (b0 & 0xF0) == 0xE0: {
        if index + 2 >= len {
          return 0xFFFD, index + 1
        }
        b1 = _this.get(index + 1)
        b2 = _this.get(index + 2)
        if (b1 & 0xC0) != 0x80 or (b2 & 0xC0) != 0x80 {
          return 0xFFFD, index + 1
        }
        cp = ((u32) (b0 & 0x0F) << 12) | ((u32) (b1 & 0x3F) << 6) | (u32) (b2 & 0x3F)
        if cp < 0x800 {
          return 0xFFFD, index + 1
        }
        return cp, index + 3
      }
      // 4-byte sequence: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
      case (b0 & 0xF8) == 0xF0: {
        if index + 3 >= len {
          return 0xFFFD, index + 1
        }
        b1 = _this.get(index + 1)
        b2 = _this.get(index + 2)
        b3 = _this.get(index + 3)
        if (b1 & 0xC0) != 0x80 or (b2 & 0xC0) != 0x80 or (b3 & 0xC0) != 0x80 {
          return 0xFFFD, index + 1
        }
        cp = ((u32) (b0 & 0x07) << 18) | ((u32) (b1 & 0x3F) << 12) | ((u32) (b2 & 0x3F) << 6) | (u32) (b3 & 0x3F)
        if cp < 0x10000 or cp > 0x10FFFF {
          return 0xFFFD, index + 1
        }
        return cp, index + 4
      }
      default: {
        return 0xFFFD, index + 1
      }
    }
  }

  /*
   * Returns the size of this string in _bytes_. It excludes the nul byte,
   * since it's not relevant.
   */
  #public
  size() -> i32 {
    return _this._byte_length - 1
  }

  /*
   * Returns the size of this string in code points.
   */
  #public
  codePointsSize() -> i32 {
    i32 count = 0
    i32 index = 0
    i32 len = _this.size()
    u32 codePoint
    i32 next

    while index < len {
      codePoint, next = _this.getCodePoint(index)
      count = count + 1
      index = next
    }

    return count
  }

  /*
   * Returns the size of this string in graphemes (actual characters
   * on the screen). Multiple code points can be used for a single
   * grapheme (i.e. a character such as `e` and an accent code point,
   * that will be rendered in the same grapheme)
   *
   * MVP: each code point is treated as one grapheme.
   */
  #public
  graphemeSize() -> i32 {
    return _this.codePointsSize()
  }

  /**
   * Checks if the current string is exactly the same as the other string.
   */
  #public
  equals(HasEquals other) -> bool {
    if other not instanceof str {
      return 0
    }

    str otherStr = (str) other
    bool result

    native {
      if (!otherStr) {
        result = 0;
      } else if (_this->_byte_length != otherStr->_byte_length) {
        result = 0;
      } else {
        result = caffc_strcmp(_this->_caffc_data, otherStr->_caffc_data) == 0 ? 1 : 0;
      }
    }

    return result
  }

  /**
   * Returns a hash code for this string using FNV-1a algorithm.
   */
  #public
  hash() -> i32 {
    i32 result

    native {
      result = 2166136261;
      caffc_u8* data = _this->_caffc_data;
      while (*data) {
        result ^= (caffc_i32) *data;
        result = result * 16777619;
        data++;
      }
    }

    return result
  }

  /**
   * Returns the index of another string inside the current string if it exists,
   * or `-1` if it doesn't exists.
   */
  #public
  indexOf(str needle) -> i32 {
    if not needle {
      raise("illegal null argument")
    }

    i32 result

    native {
      result = caffc_index_of(_this->_caffc_data, _this->_byte_length - 1,
                              needle->_caffc_data, needle->_byte_length - 1);
    }

    return result
  }

  /**
   * Compares a string to another string for ordering purposes.
   */
  #public
  compareTo(str other) -> i32 {
    if not other {
      raise("illegal null argument")
    }

    i32 result

    native {
      result = caffc_strcmp(_this->_caffc_data, other->_caffc_data);
    }

    return result
  }
}

isGrapheme(u32 code) -> bool {
  // MVP: every code point starts a grapheme cluster.
  return true
}


