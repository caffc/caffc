    _this.codePageToUtf8.put(0xDD, 0x279D)
    _this.utf8ToCodePage.put(0x279D, 0xDD)
    _this.codePageToUtf8.put(0xDE, 0x279E)
    _this.utf8ToCodePage.put(0x279E, 0xDE)
    _this.codePageToUtf8.put(0xDF, 0x279F)
    _this.utf8ToCodePage.put(0x279F, 0xDF)
    _this.codePageToUtf8.put(0xE0, 0x27A0)
    _this.utf8ToCodePage.put(0x27A0, 0xE0)
    _this.codePageToUtf8.put(0xE1, 0x27A1)
    _this.utf8ToCodePage.put(0x27A1, 0xE1)
    _this.codePageToUtf8.put(0xE2, 0x27A2)
