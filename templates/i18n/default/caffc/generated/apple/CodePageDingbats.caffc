    _this.utf8ToCodePage.put(0x27A6, 0xE6)
    _this.codePageToUtf8.put(0xE7, 0x27A7)
    _this.utf8ToCodePage.put(0x27A7, 0xE7)
    _this.codePageToUtf8.put(0xE8, 0x27A8)
    _this.utf8ToCodePage.put(0x27A8, 0xE8)
    _this.codePageToUtf8.put(0xE9, 0x27A9)
    _this.utf8ToCodePage.put(0x27A9, 0xE9)
    _this.codePageToUtf8.put(0xEA, 0x27AA)
    _this.utf8ToCodePage.put(0x27AA, 0xEA)
    _this.codePageToUtf8.put(0xEB, 0x27AB)
    _this.utf8ToCodePage.put(0x27AB, 0xEB)
