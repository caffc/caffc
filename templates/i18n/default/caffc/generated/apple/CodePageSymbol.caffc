    _this.codePageToUtf8.put(0xE9, 0x23A1)
    _this.utf8ToCodePage.put(0x23A1, 0xE9)
    _this.codePageToUtf8.put(0xEA, 0x23A2)
    _this.utf8ToCodePage.put(0x23A2, 0xEA)
    _this.codePageToUtf8.put(0xEB, 0x23A3)
    _this.utf8ToCodePage.put(0x23A3, 0xEB)
    _this.codePageToUtf8.put(0xEC, 0x23A7)
    _this.utf8ToCodePage.put(0x23A7, 0xEC)
    _this.codePageToUtf8.put(0xED, 0x23A8)
    _this.utf8ToCodePage.put(0x23A8, 0xED)
    _this.codePageToUtf8.put(0xEE, 0x23A9)
    _this.utf8ToCodePage.put(0x23A9, 0xEE)
    _this.codePageToUtf8.put(0xEF, 0x23AA)
    _this.utf8ToCodePage.put(0x23AA, 0xEF)
    _this.codePageToUtf8.put(0xF0, 0xF8FF)
    _this.utf8ToCodePage.put(0xF8FF, 0xF0)
    _this.codePageToUtf8.put(0xF1, 0x3009)
    _this.utf8ToCodePage.put(0x3009, 0xF1)
    _this.codePageToUtf8.put(0xF2, 0x222B)
    _this.utf8ToCodePage.put(0x222B, 0xF2)
    _this.codePageToUtf8.put(0xF3, 0x2320)
    _this.utf8ToCodePage.put(0x2320, 0xF3)
    _this.codePageToUtf8.put(0xF4, 0x23AE)
    _this.utf8ToCodePage.put(0x23AE, 0xF4)
    _this.codePageToUtf8.put(0xF5, 0x2321)
    _this.utf8ToCodePage.put(0x2321, 0xF5)
    _this.codePageToUtf8.put(0xF6, 0x239E)
    _this.utf8ToCodePage.put(0x239E, 0xF6)
    _this.codePageToUtf8.put(0xF7, 0x239F)
    _this.utf8ToCodePage.put(0x239F, 0xF7)
    _this.codePageToUtf8.put(0xF8, 0x23A0)
    _this.utf8ToCodePage.put(0x23A0, 0xF8)
    _this.codePageToUtf8.put(0xF9, 0x23A4)
    _this.utf8ToCodePage.put(0x23A4, 0xF9)
    _this.codePageToUtf8.put(0xFA, 0x23A5)
    _this.utf8ToCodePage.put(0x23A5, 0xFA)
    _this.codePageToUtf8.put(0xFB, 0x23A6)
    _this.utf8ToCodePage.put(0x23A6, 0xFB)
    _this.codePageToUtf8.put(0xFC, 0x23AB)
    _this.utf8ToCodePage.put(0x23AB, 0xFC)
    _this.codePageToUtf8.put(0xFD, 0x23AC)
    _this.utf8ToCodePage.put(0x23AC, 0xFD)
    _this.codePageToUtf8.put(0xFE, 0x23AD)
    _this.utf8ToCodePage.put(0x23AD, 0xFE)
  }

  name() -> str {
    return "mac-symbol"
  }

  vendor() -> str {
    return "Apple"
  }

  fromUtf8(str value) -> u8[] data, bool error, i32 errorByteIndex {
    i32 currentByteIndex = 0
    i32 nextByteIndex = 0
    i32 outByteIndex = 0
    u8 byteValue
    bool codePageError
    u32 codePoint

    if not value or value.size() == 0 {
      return EMPTY_U8_ARRAY, false, -1
    }

    data = new u8[value.codePointsSize()]

    errorByteIndex = -1
    while nextByteIndex < value.size() {
      currentByteIndex = nextByteIndex
      codePoint, nextByteIndex = value.getCodePoint(currentByteIndex)
      byteValue, codePageError = _this.utf8ToCodePage.get(codePoint)

      if codePageError {
        byteValue = '?'
      }
      if codePageError and errorByteIndex < 0 {
        errorByteIndex = currentByteIndex
      }

      data[outByteIndex] = byteValue
      outByteIndex = outByteIndex + 1
    }

    return data, errorByteIndex >= 0, errorByteIndex
  }

  toUtf8(u8[] data) -> str value, bool error, i32 errorIndex {
    i32 i = 0
    i32 out = 0
    i32 dataLen
    u32 codePoint
    bool codePageError
    u8 b
    u8[] buf

    if not data {
      return "", false, -1
    }

    dataLen = (i32) data.size
    if dataLen == 0 {
      return "", false, -1
    }

    // Worst case: 4 UTF-8 bytes per code-page byte
    buf = new u8[dataLen * 4 + 1]
    errorIndex = -1

    while i < dataLen {
      b = data[i]
      codePoint, codePageError = _this.codePageToUtf8.get(b)

      if codePageError {
        codePoint = 0x3F
      }
      if codePageError and errorIndex < 0 {
        errorIndex = i
      }

      switch {
        case codePoint <= 0x7F: {
          buf[out] = (u8) codePoint
          out = out + 1
        }
        case codePoint <= 0x7FF: {
          buf[out] = (u8) (0xC0 | (codePoint >> 6))
          buf[out + 1] = (u8) (0x80 | (codePoint & 0x3F))
          out = out + 2
        }
        case codePoint <= 0xFFFF: {
          buf[out] = (u8) (0xE0 | (codePoint >> 12))
          buf[out + 1] = (u8) (0x80 | ((codePoint >> 6) & 0x3F))
          buf[out + 2] = (u8) (0x80 | (codePoint & 0x3F))
          out = out + 3
        }
        default: {
          buf[out] = (u8) (0xF0 | (codePoint >> 18))
          buf[out + 1] = (u8) (0x80 | ((codePoint >> 12) & 0x3F))
          buf[out + 2] = (u8) (0x80 | ((codePoint >> 6) & 0x3F))
          buf[out + 3] = (u8) (0x80 | (codePoint & 0x3F))
          out = out + 4
        }
      }

      i = i + 1
    }

    buf[out] = 0
    value = str.fromPtrBuffer(buf._caffc_data, out)
    return value, errorIndex >= 0, errorIndex
  }
}

unit_init() {
  CodePageEncoding codePage = new CodePageSymbol()
  codePages.put(codePage.name(), codePage)
}
}
